<Project>

  <!--
    Central Package Management (CPM) version table.
    All csprojs reference packages WITHOUT inline Version= attributes;
    the version is resolved from this file.
    Keep entries sorted by package name within each group.
  -->

  <ItemGroup>

    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.18" />

    <!-- Diagnostics / structured logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />

    <!-- Static analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />

    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

  </ItemGroup>

</Project>

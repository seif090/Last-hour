# =============================================================================
# LastHour development environment
# Copy this file to docker/.env and adjust before running:
#   docker compose --env-file docker/.env --project-directory . -f docker/docker-compose.yml up -d
# Never commit real secrets. The values below are placeholders only.
# =============================================================================

# --- API ---
API_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=last_hour
POSTGRES_USER=last_hour
POSTGRES_PASSWORD=last_hour
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Seq (structured log aggregation) ---
SEQ_PORT=5341
# Optional API key used by the Seq sink. Leave empty to connect without a key.
SEQ_API_KEY=
# Generate a hash with: docker run --rm datalust/seq config hash
SEQ_PASSWORD_HASH=

# --- PgAdmin ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@lasthour.local
PGADMIN_DEFAULT_PASSWORD=admin

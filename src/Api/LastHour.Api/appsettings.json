{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/last-hour-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cqrs": {
    "Performance": {
      "SlowRequestThreshold": "00:00:01"
    }
  },
  "ResponseCompression": {
    "Enabled": true,
    "EnableForHttps": true,
    "CompressionLevel": "SmallestSize",
    "MimeTypes": [ "application/problem+json" ]
  },
  "OutputCache": {
    "Enabled": true,
    "UseCaseSensitivePaths": false,
    "Profiles": [
      {
        "Name": "Default",
        "DurationSeconds": 60,
        "VaryByQueryKeys": [ "*" ],
        "Tags": [ "default" ]
      }
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "RejectionStatusCode": 429,
    "GlobalPolicyName": "Global",
    "Policies": [
      {
        "Name": "Global",
        "Algorithm": "FixedWindow",
        "PartitionBy": "Global",
        "PermitLimit": 120,
        "WindowSeconds": 60,
        "QueueLimit": 0,
        "AutoReplenishment": true
      },
      {
        "Name": "SystemStatus",
        "Algorithm": "SlidingWindow",
        "PartitionBy": "IpAddress",
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 2,
        "QueueLimit": 0,
        "AutoReplenishment": true
      }
    ]
  }
}

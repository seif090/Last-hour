<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Single, audited package source.
    packageSourceMapping binds every package id to nuget.org, so dependency
    confusion / supply-chain attacks via a mismatched source are impossible.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

</configuration>
